#!/usr/bin/env bash
# shellcheck disable=SC2016
# Generate docs/CATALOG.md and the module table in README.md from
# modules/*/module.conf. Run after editing a manifest.
set -Eeuo pipefail

REPO_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
MODULES_DIR="$REPO_DIR/modules"
# shellcheck source=scripts/lib.sh
source "$REPO_DIR/scripts/lib.sh"
# shellcheck source=scripts/modules.sh
source "$REPO_DIR/scripts/modules.sh"

TABLE_FILE="$(mktemp)"
CATALOG_FILE="$(mktemp)"
README_TMP="$(mktemp)"
trap 'rm -f -- "$TABLE_FILE" "$CATALOG_FILE" "$README_TMP"' EXIT

escape_md() {
  sed 's/|/\\|/g'
}

{
  printf '| Module | Scope | Category | Packages | Description | Warning |\n'
  printf '|---|---|---|---|---|---|\n'
  while IFS= read -r m; do
    module_validate "$m"
    scope="$(module_scope "$m")"
    packages="$(module_packages "$m" | paste -sd ', ' -)"
    [[ -n "$packages" ]] || packages="—"
    description="$(module_field "$m" description | escape_md)"
    warning=""
    if [[ "$scope" == "shared" ]]; then
      warning="**Shared: may affect KDE**"
    fi
    printf '| `%s` | %s | %s | %s | %s | %s |\n' \
      "$m" "$scope" "$(module_field "$m" category | escape_md)" \
      "$packages" "$description" "$warning"
  done < <(module_names)
} > "$TABLE_FILE"

{
  printf '%s\n' '# Module catalog'
  printf '\n'
  printf '%s\n' 'Generated from `modules/*/module.conf` by `scripts/gen-catalog`. Do not edit by hand.'
  printf '\n'
  printf '%s\n' 'Scoped modules run only inside Hyprland. Shared modules are reachable from KDE too; they are never in the base, conflicts abort, and their configs may change KDE-visible tooling. Each module is package-only by default; configure the app normally in `$HOME`, then run `./install.sh adopt <module>`.'
  printf '\n'
  cat "$TABLE_FILE"
  printf '\n'
  printf '%s\n' '## Module notes'
  printf '\n'
  while IFS= read -r m; do
    printf '### `%s`\n\n' "$m"
    printf '%s\n' "- Scope: \`$(module_scope "$m")\`"
    printf '%s\n' "- Category: $(module_field "$m" category)"
    printf '%s\n' "- Packages: \`$(module_packages "$m" | paste -sd ' ' -)\`"
    printf '%s\n' "- Config paths: \`$(module_field "$m" config_paths)\`"
    printf '%s\n' "- Notes: $(module_field "$m" notes)"
    printf '\n'
  done < <(module_names)
} > "$CATALOG_FILE"

cp -- "$CATALOG_FILE" "$REPO_DIR/docs/CATALOG.md"
info "Wrote docs/CATALOG.md"

if grep -q '<!-- BEGIN MODULE TABLE -->' "$REPO_DIR/README.md" &&
   grep -q '<!-- END MODULE TABLE -->' "$REPO_DIR/README.md"; then
  awk -v tablefile="$TABLE_FILE" '
    /<!-- BEGIN MODULE TABLE -->/ {
      print
      while ((getline line < tablefile) > 0) print line
      close(tablefile)
      skip = 1
      next
    }
    /<!-- END MODULE TABLE -->/ {
      skip = 0
      print
      next
    }
    !skip { print }
  ' "$REPO_DIR/README.md" > "$README_TMP"
  cp -- "$README_TMP" "$REPO_DIR/README.md"
  info "Updated README.md module table"
else
  warn "README.md has no module-table markers; only docs/CATALOG.md was updated."
fi
