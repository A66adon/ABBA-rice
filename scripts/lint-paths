#!/usr/bin/env bash
# Fail if any stow package would land on the KDE/shared-tool denylist.
set -Eeuo pipefail

REPO_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/lib.sh
source "$REPO_DIR/scripts/lib.sh"
# shellcheck source=scripts/modules.sh
source "$REPO_DIR/scripts/modules.sh"

FAIL=0

denied_rel() {
  local rel="$1"
  case "$rel" in
    .config/kdeglobals|.config/kwinrc|.config/konsolerc|.config/dolphinrc|\
    .config/kscreenlockerrc|.config/baloofilerc|.config/mimeapps.list|\
    .config/xdg-terminals.list|.config/fontconfig|.config/gtk-3.0|\
    .config/gtk-4.0|.config/environment.d|.config/autostart|\
    .config/systemd|.config/dconf)
      return 0
      ;;
    .config/plasma*|.config/kde*)
      return 0
      ;;
    .config/gtk-3.0/*|.config/gtk-4.0/*|.config/fontconfig/*|\
    .config/environment.d/*|.config/autostart/*|.config/systemd/*|\
    .config/dconf/*)
      return 0
      ;;
    .local/share/konsole|.local/share/konsole/*|\
    .local/share/applications|.local/share/applications/*|\
    .local/share/fonts|.local/share/fonts/*|\
    .local/share/icons|.local/share/icons/*)
      return 0
      ;;
    .icons|.icons/*|.profile|.bash*|.zsh*|.gitconfig|.Xresources)
      return 0
      ;;
    .config/xdg-desktop-portal/hyprland-portals.conf)
      return 1
      ;;
    .config/xdg-desktop-portal/*)
      return 0
      ;;
  esac
  return 1
}

check_package() {
  local root="$1" label="$2" file rel
  [[ -d "$root" ]] || return 0
  while IFS= read -r -d '' file; do
    rel="${file#"$root/"}"
    [[ "$rel" == "module.conf" ]] && continue
    if denied_rel "$rel"; then
      err "denied stow path: $label/$rel -> ~/$rel"
      FAIL=1
    fi
    if [[ -f "$file" ]] && grep -Iq -- '/home/' "$file" 2>/dev/null; then
      err "absolute /home path in $label/$rel"
      FAIL=1
    fi
  done < <(find "$root" -mindepth 1 \( -type f -o -type l \) -print0)
}

info "Checking base stow package..."
check_package "$REPO_DIR/base/hypr" "base/hypr"

info "Checking module manifests..."
while IFS= read -r m; do
  module_validate "$m"
done < <(module_names)

info "Checking module stow payloads..."
while IFS= read -r m; do
  check_package "$REPO_DIR/modules/$m" "modules/$m"
done < <(module_names)

info "Checking host stow payloads..."
if [[ -d "$REPO_DIR/hosts" ]]; then
  while IFS= read -r h; do
    check_package "$REPO_DIR/hosts/$h" "hosts/$h"
    while IFS= read -r -d '' file; do
      rel="${file#"$REPO_DIR/hosts/$h/"}"
      case "$rel" in
        .config/hypr/host.lua|.config/waybar/host.jsonc) ;;
        *)
          err "unexpected host payload: hosts/$h/$rel (only host.lua and host.jsonc are allowed)"
          FAIL=1
          ;;
      esac
    done < <(find "$REPO_DIR/hosts/$h" -mindepth 1 \( -type f -o -type l \) -print0)
  done < <(find "$REPO_DIR/hosts" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | LC_ALL=C sort)
fi

info "Checking that shared modules are not in base/packages.txt..."
base_pkgs="$(awk 'NF && $1 !~ /^#/ {print $1}' "$REPO_DIR/base/packages.txt")"
while IFS= read -r m; do
  [[ "$(module_scope "$m")" == "shared" ]] || continue
  while IFS= read -r p; do
    if grep -qxF -- "$p" <<< "$base_pkgs"; then
      err "shared module '$m' package '$p' is in base/packages.txt"
      FAIL=1
    fi
  done < <(module_packages "$m")
done < <(module_names)

if (( FAIL )); then
  die "lint-paths found violations."
fi
info "lint-paths: no denylisted paths."
