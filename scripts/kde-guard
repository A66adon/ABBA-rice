#!/usr/bin/env bash
# Read-only KDE guard.
#
#   scripts/kde-guard snapshot [dir]
#   scripts/kde-guard diff [before] [after]
#
# Snapshots go under ~/.local/state/<repo>/kde-guard/<timestamp>/.
# The guard never edits /etc, ~/.config, or any system state.
set -Eeuo pipefail

REPO_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/lib.sh
source "$REPO_DIR/scripts/lib.sh"
# shellcheck source=scripts/modules.sh
source "$REPO_DIR/scripts/modules.sh"

GUARD_ROOT="$(repo_state_root)/kde-guard"

for required in find sort xargs sha256sum awk sed comm; do
  have "$required" || die "kde-guard requires '$required'."
done

usage() {
  cat <<'EOF'
Usage:
  scripts/kde-guard snapshot [directory]
  scripts/kde-guard diff [before] [after]

With no arguments, diff uses the two most recent snapshots.
Take snapshots from a TTY with no Plasma session active.
EOF
}

hash_tree() {
  local root="$1"
  { find "$root" -type f -readable -print0 2>/dev/null || true; } |
    LC_ALL=C sort -z |
    xargs -0 -r sha256sum --
}

list_dir() {
  local dir="$1"
  if [[ -d "$dir" ]]; then
    find "$dir" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | LC_ALL=C sort
  fi
}

snapshot() {
  local dir base n=1
  if [[ -n "${1:-}" ]]; then
    dir="$1"
  else
    base="$GUARD_ROOT/$(date -u +%Y%m%dT%H%M%SZ)"
    dir="$base"
    while [[ -e "$dir" ]]; do
      dir="$base-$n"
      ((n++))
    done
  fi
  local user shell_line key family value
  mkdir -p -- "$dir"

  user="$(id -un)"
  {
    printf 'timestamp=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'hostname=%s\n' "$(current_hostname)"
    printf 'user=%s\n' "$user"
    if pgrep -x plasmashell >/dev/null 2>&1 || pgrep -x kwin_wayland >/dev/null 2>&1; then
      printf 'plasma_running=yes\n'
    else
      printf 'plasma_running=no\n'
    fi
  } > "$dir/meta"

  shell_line="$(getent passwd "$user" 2>/dev/null || true)"
  printf '%s\n' "$shell_line" > "$dir/login-shell"

  hash_tree /etc > "$dir/etc.sha256"
  { find /etc -type f ! -readable 2>/dev/null || true; } | wc -l > "$dir/etc-unreadable"

  systemctl list-unit-files --state=enabled --no-pager --no-legend 2>/dev/null |
    LC_ALL=C sort > "$dir/units-system" || true
  systemctl --user list-unit-files --state=enabled --no-pager --no-legend 2>/dev/null |
    LC_ALL=C sort > "$dir/units-user" || true

  pacman -Qq 2>/dev/null | LC_ALL=C sort > "$dir/pacman-q"

  list_dir /etc/xdg/autostart > "$dir/listing-autostart"
  list_dir /usr/lib/systemd/user > "$dir/listing-systemd-user"
  list_dir /usr/share/dbus-1/services > "$dir/listing-dbus-services"
  list_dir /usr/share/wayland-sessions > "$dir/listing-wayland-sessions"

  : > "$dir/fc-match"
  for family in monospace sans-serif serif emoji; do
    if have fc-match; then
      value="$(fc-match "$family" 2>/dev/null || true)"
    else
      value="unavailable"
    fi
    printf '%s: %s\n' "$family" "$value" >> "$dir/fc-match"
  done

  : > "$dir/kde-fonts"
  for key in font fixed menuFont; do
    if have kreadconfig6; then
      value="$(kreadconfig6 --file kdeglobals --group General --key "$key" 2>/dev/null || true)"
    else
      value="unavailable"
    fi
    printf '%s=%s\n' "$key" "$value" >> "$dir/kde-fonts"
  done

  : > "$dir/home.sha256"
  declare -A seen=()
  add_path() {
    local p="$1" match
    if [[ "$p" == *'*'* || "$p" == *'?'* || "$p" == *'['* ]]; then
      local -a matches=()
      mapfile -t matches < <(compgen -G "$p" || true)
      if ((${#matches[@]} == 0)); then
        printf 'absent %s\n' "$p" >> "$dir/home.sha256"
        return 0
      fi
      for match in "${matches[@]}"; do
        add_one "$match"
      done
    else
      add_one "$p"
    fi
  }
  add_one() {
    local p="$1"
    [[ -n "${seen[$p]:-}" ]] && return 0
    seen[$p]=1
    if [[ -L "$p" ]]; then
      printf 'link %s -> %s\n' "$p" "$(readlink -- "$p" 2>/dev/null || true)" >> "$dir/home.sha256"
      if [[ -f "$p" ]]; then
        sha256sum -- "$p" >> "$dir/home.sha256"
      fi
    elif [[ -d "$p" ]]; then
      while IFS= read -r -d '' match; do
        add_one "$match"
      done < <(find "$p" -mindepth 1 \( -type f -o -type l \) -print0 2>/dev/null | LC_ALL=C sort -z)
    elif [[ -f "$p" ]]; then
      sha256sum -- "$p" >> "$dir/home.sha256"
    else
      printf 'absent %s\n' "$p" >> "$dir/home.sha256"
    fi
  }

  local p
  for p in \
    "$HOME/.config"/k* \
    "$HOME/.config"/plasma* \
    "$HOME/.config/konsolerc" \
    "$HOME/.config"/gtk-* \
    "$HOME/.config/fontconfig" \
    "$HOME/.config/environment.d" \
    "$HOME/.config/mimeapps.list" \
    "$HOME/.config/autostart" \
    "$HOME/.config/systemd" \
    "$HOME/.config/dconf" \
    "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc" \
    "$HOME/.local/share/konsole" \
    "$HOME/.profile" \
    "$HOME/.bashrc" \
    "$HOME/.bash_profile" \
    "$HOME/.bash_login" \
    "$HOME/.bash_logout" \
    "$HOME/.zshrc" \
    "$HOME/.zprofile" \
    "$HOME/.zshenv" \
    "$HOME/.zlogin" \
    "$HOME/.zlogout" \
    "$HOME/.gitconfig" \
    "$HOME/.config/fish" \
    "$HOME/.config/starship.toml" \
    "$HOME/.config/tmux" \
    "$HOME/.config/nvim" \
    "$HOME/.config/btop" \
    "$HOME/.config/fastfetch" \
    "$HOME/.config/cava"; do
    add_path "$p"
  done

  printf '%s\n' "$dir"
}

field_path() {
  local line="$1"
  if [[ "$line" == link\ * ]]; then
    printf '%s\n' "$line" | awk '{print $2}'
  elif [[ "$line" == absent\ * ]]; then
    printf '%s\n' "$line" | awk '{print $2}'
  else
    printf '%s\n' "$line" | awk '{print $2}'
  fi
}

package_side_effect() {
  case "$1" in
    /etc/ld.so.cache|/etc/.updated|\
    /etc/passwd|/etc/passwd-|/etc/group|/etc/group-|\
    /etc/shadow|/etc/shadow-|/etc/gshadow|/etc/gshadow-|\
    /etc/subuid|/etc/subuid-|/etc/subgid|/etc/subgid-|\
    /etc/shells)
      return 0
      ;;
  esac
  return 1
}

repo_targets_file() {
  local out="$1" m rel host_name
  : > "$out"
  while IFS= read -r rel; do
    printf '%s\n' "$HOME/$rel" >> "$out"
  done < <(package_targets "$REPO_DIR/base" hypr)
  while IFS= read -r m; do
    while IFS= read -r rel; do
      printf '%s\n' "$HOME/$rel" >> "$out"
    done < <(package_targets "$REPO_DIR/modules" "$m")
  done < <(enabled_modules)
  host_name="$(current_hostname | tr -d '[:space:]')"
  if [[ -d "$REPO_DIR/hosts/$host_name" ]]; then
    while IFS= read -r rel; do
      printf '%s\n' "$HOME/$rel" >> "$out"
    done < <(package_targets "$REPO_DIR/hosts" "$host_name")
  fi
  LC_ALL=C sort -u -o "$out" "$out"
}

path_is_shared_repo_target() {
  local path="$1" m rel
  while IFS= read -r m; do
    [[ "$(module_scope "$m")" == "shared" ]] || continue
    while IFS= read -r rel; do
      if [[ "$path" == "$HOME/$rel" || "$path" == "$HOME/$rel/"* ]]; then
        return 0
      fi
    done < <(package_targets "$REPO_DIR/modules" "$m")
  done < <(enabled_modules)
  return 1
}

diff_snapshots() {
  local before="${1:-}" after="${2:-}"
  local -a snapshots=()
  if [[ -z "$before" || -z "$after" ]]; then
    mapfile -t snapshots < <(find "$GUARD_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | LC_ALL=C sort)
    ((${#snapshots[@]} >= 2)) || die "Need two snapshots for diff; found ${#snapshots[@]}."
    before="${snapshots[-2]}"
    after="${snapshots[-1]}"
  fi
  [[ -d "$before" && -d "$after" ]] || die "Snapshot directory not found."

  have diff || die "kde-guard diff requires 'diff' (diffutils)."
  local tmp new_pkg_files new_pkgs_file failures=0 warnings=0
  tmp="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf -- $(printf '%q' "$tmp")" EXIT
  new_pkg_files="$tmp/new-package-files"
  new_pkgs_file="$tmp/new-packages"
  : > "$new_pkg_files"
  comm -13 <(LC_ALL=C sort "$before/pacman-q") <(LC_ALL=C sort "$after/pacman-q") > "$new_pkgs_file"
  local pkg path
  while IFS= read -r pkg; do
    [[ -n "$pkg" ]] || continue
    if package_is_installed "$pkg"; then
      while IFS= read -r path; do
        [[ "$path" == /* ]] || path="/$path"
        printf '%s\n' "$path" >> "$new_pkg_files"
      done < <(pacman -Qlq -- "$pkg" 2>/dev/null)
    fi
  done < "$new_pkgs_file"
  LC_ALL=C sort -u -o "$new_pkg_files" "$new_pkg_files"

  info "KDE guard diff: $before -> $after"
  local before_meta after_meta
  before_meta="$(awk -F= '/^plasma_running=/{print $2}' "$before/meta" 2>/dev/null || true)"
  after_meta="$(awk -F= '/^plasma_running=/{print $2}' "$after/meta" 2>/dev/null || true)"
  if [[ "$before_meta" != "$after_meta" ]]; then
    warn "Plasma running state changed between snapshots ($before_meta -> $after_meta); the diff may be unreliable."
    warnings=$((warnings + 1))
  fi

  fail() { err "$*"; failures=$((failures + 1)); }

  if ! diff -q -- "$before/login-shell" "$after/login-shell" >/dev/null 2>&1; then
    fail "Login shell changed:"
    diff -u -- "$before/login-shell" "$after/login-shell" || true
  else
    info "Login shell unchanged."
  fi

  local etc_diff
  etc_diff="$tmp/etc.diff"
  diff -u -- "$before/etc.sha256" "$after/etc.sha256" > "$etc_diff" || true
  if [[ -s "$etc_diff" ]]; then
    info "Changed /etc files:"
    cat -- "$etc_diff"
    while IFS= read -r path; do
      [[ -n "$path" ]] || continue
      if grep -qxF -- "$path" "$new_pkg_files"; then
        info "  explained by a new package: $path"
      elif package_side_effect "$path"; then
        info "  explained by a package-manager side effect: $path"
      else
        fail "  unexplained /etc change: $path"
      fi
    done < <(sed -n -E 's/^[+-][0-9a-f]{64}  (.*)$/\1/p' "$etc_diff" | LC_ALL=C sort -u)
  else
    info "/etc hashes unchanged."
  fi

  local units_diff unit
  units_diff="$tmp/units.diff"
  diff -u -- "$before/units-system" "$after/units-system" > "$units_diff" || true
  if [[ -s "$units_diff" ]]; then
    info "Enabled system units changed:"
    cat -- "$units_diff"
    while IFS= read -r unit; do
      [[ -n "$unit" ]] || continue
      if grep -qF -- "/$unit" "$new_pkg_files"; then
        warn "  enabled system unit shipped by a new package: $unit"
      else
        fail "  unexplained enabled system unit: $unit"
      fi
    done < <(sed -n -E 's/^\+([^+][^ ]*).*/\1/p' "$units_diff")
    while IFS= read -r unit; do
      [[ -n "$unit" ]] || continue
      fail "  enabled system unit removed: $unit"
    done < <(sed -n -E 's/^-([^-][^ ]*).*/\1/p' "$units_diff")
  else
    info "Enabled system units unchanged."
  fi
  units_diff="$tmp/units-user.diff"
  diff -u -- "$before/units-user" "$after/units-user" > "$units_diff" || true
  if [[ -s "$units_diff" ]]; then
    info "Enabled user units changed:"
    cat -- "$units_diff"
    while IFS= read -r unit; do
      [[ -n "$unit" ]] || continue
      if grep -qF -- "/$unit" "$new_pkg_files"; then
        warn "  enabled user unit shipped by a new package: $unit"
      else
        fail "  unexplained enabled user unit: $unit"
      fi
    done < <(sed -n -E 's/^\+([^+][^ ]*).*/\1/p' "$units_diff")
    while IFS= read -r unit; do
      [[ -n "$unit" ]] || continue
      fail "  enabled user unit removed: $unit"
    done < <(sed -n -E 's/^-([^-][^ ]*).*/\1/p' "$units_diff")
  else
    info "Enabled user units unchanged."
  fi

  local section source_prefix name full
  for section in listing-autostart listing-systemd-user listing-dbus-services listing-wayland-sessions; do
    case "$section" in
      listing-autostart) source_prefix=/etc/xdg/autostart ;;
      listing-systemd-user) source_prefix=/usr/lib/systemd/user ;;
      listing-dbus-services) source_prefix=/usr/share/dbus-1/services ;;
      listing-wayland-sessions) source_prefix=/usr/share/wayland-sessions ;;
    esac
    local secdiff="$tmp/$section.diff"
    diff -u -- "$before/$section" "$after/$section" > "$secdiff" || true
    [[ -s "$secdiff" ]] || continue
    info "Changed $section:"
    cat -- "$secdiff"
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      full="$source_prefix/$name"
      if grep -qxF -- "$full" "$new_pkg_files"; then
        info "  explained by a new package: $full"
        if [[ "$section" == "listing-autostart" && -r "$full" ]]; then
          local only notshow
          only="$(sed -n 's/^OnlyShowIn=//p' "$full" | head -n1)"
          notshow="$(sed -n 's/^NotShowIn=//p' "$full" | head -n1)"
          if [[ "$notshow" != *KDE* && ( -z "$only" || "$only" == *KDE* ) ]]; then
            fail "  KDE-visible autostart entry appeared: $full"
          fi
        fi
      else
        fail "  unexplained listing change: $full"
      fi
    done < <(sed -n -E 's/^\+([^+].*)$/\1/p' "$secdiff")
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      full="$source_prefix/$name"
      fail "  unexplained removal from $section: $full"
    done < <(sed -n -E 's/^-([^-].*)$/\1/p' "$secdiff")
  done

  if ! diff -q -- "$before/fc-match" "$after/fc-match" >/dev/null 2>&1; then
    fail "fc-match changed (font requirement):"
    diff -u -- "$before/fc-match" "$after/fc-match" || true
  else
    info "fc-match unchanged."
  fi

  if ! diff -q -- "$before/kde-fonts" "$after/kde-fonts" >/dev/null 2>&1; then
    fail "KDE configured fonts changed:"
    diff -u -- "$before/kde-fonts" "$after/kde-fonts" || true
  else
    info "KDE configured fonts unchanged."
  fi

  local repo_targets home_diff
  repo_targets="$tmp/repo-targets"
  repo_targets_file "$repo_targets"
  home_diff="$tmp/home.diff"
  diff -u -- "$before/home.sha256" "$after/home.sha256" > "$home_diff" || true
  if [[ -s "$home_diff" ]]; then
    info "Changed home config files:"
    cat -- "$home_diff"
    while IFS= read -r path; do
      [[ -n "$path" ]] || continue
      if grep -qxF -- "$path" "$repo_targets"; then
        if path_is_shared_repo_target "$path"; then
          warn "  shared module repo change (may affect KDE): $path"
          warnings=$((warnings + 1))
        else
          info "  explained by a scoped repo module: $path"
        fi
      else
        fail "  unexplained home config change: $path"
      fi
    done < <(sed -n -E 's/^([+-][0-9a-f]{64}  |link |absent )//p' "$home_diff" | awk '{print $1}' | LC_ALL=C sort -u)
  else
    info "Home config hashes unchanged."
  fi

  if [[ -s "$new_pkgs_file" ]]; then
    info "New packages:"
    sed 's/^/  /' "$new_pkgs_file"
    info "Tray/autostart files shipped by new packages:"
    grep -E '^/(etc/xdg/autostart|usr/share/applications|usr/share/dbus-1/services|usr/lib/systemd/user)/' "$new_pkg_files" |
      sed 's/^/  /' || true
  fi

  local unreadable
  unreadable="$(cat "$after/etc-unreadable" 2>/dev/null || echo 0)"
  if [[ "$unreadable" != "0" ]]; then
    warn "Guard could not read $unreadable file(s) under /etc; changes there are not covered."
    warnings=$((warnings + 1))
  fi

  if (( failures )); then
    err "KDE guard: $failures unexplained/forbidden change(s), $warnings warning(s)."
    return 1
  fi
  if (( warnings )); then
    warn "KDE guard: no unexplained changes, but $warnings warning(s) need review."
  else
    info "KDE guard: no unexplained or forbidden changes."
  fi
  return 0
}

command_name="${1:-}"
[[ $# -gt 0 ]] && shift
case "$command_name" in
  snapshot) snapshot "$@" ;;
  diff) diff_snapshots "$@" ;;
  ""|-h|--help) usage ;;
  *) usage >&2; die "Unknown command: $command_name" ;;
esac
